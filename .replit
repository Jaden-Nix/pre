[agent]
expertMode = true
integrations = ["sendgrid:1.0.0", "perplexity_v0:1.0.0", "javascript_openai_ai_integrations:1.0.0", "javascript_openai:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["killall"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Predora Backend"

[[workflows.workflow]]
name = "Start Predora Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npm install viem --legacy-peer-deps && node index.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

