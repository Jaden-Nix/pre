modules = ["web", "nodejs-20"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34733
externalPort = 3000

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["killall"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Predora Client"

[[workflows.workflow]]
name = "Start Predora Client"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd client && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"


