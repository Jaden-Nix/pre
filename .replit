modules = ["web", "nodejs-20"]

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 39207
externalPort = 6800

[[ports]]
localPort = 39619
externalPort = 8008

[[ports]]
localPort = 40319
externalPort = 5173

[[ports]]
localPort = 40827
externalPort = 6000

[[ports]]
localPort = 41045
externalPort = 3000

[[ports]]
localPort = 42969
externalPort = 3003

[[ports]]
localPort = 46419
externalPort = 4200

[[ports]]
localPort = 46539
externalPort = 8000

[[ports]]
localPort = 46855
