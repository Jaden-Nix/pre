[agent]
expertMode = true
integrations = ["sendgrid:1.0.0", "perplexity_v0:1.0.0", "javascript_openai_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["killall"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Predora App"

[[workflows.workflow]]
name = "Start Predora App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx http-server -p 5000 -a 0.0.0.0"
waitForPort = 5000


